{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Member A shared-contract review example",
  "type": "object",
  "required": ["version", "fixture", "run", "authorization", "objects", "handoff", "trace"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": "draft-a.1"},
    "fixture": {"$ref": "#/$defs/fixture"},
    "run": {"$ref": "#/$defs/run"},
    "authorization": {"$ref": "#/$defs/authorization"},
    "objects": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/registryObject"}},
    "handoff": {"$ref": "#/$defs/handoff"},
    "trace": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/event"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "fields": {"$ref": "#/$defs/ids", "minItems": 1},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "recipient": {"enum": ["controller", "mock_cloud"]},
    "role": {"enum": ["system", "user", "assistant", "tool"]},
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "scope": {
      "type": "object",
      "required": ["user_id", "task_id", "session_id", "trial_id", "device_id"],
      "additionalProperties": false,
      "properties": {
        "user_id": {"$ref": "#/$defs/id"},
        "task_id": {"$ref": "#/$defs/id"},
        "session_id": {"$ref": "#/$defs/id"},
        "trial_id": {"$ref": "#/$defs/id"},
        "device_id": {"$ref": "#/$defs/id"}
      }
    },
    "slot": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": {"$ref": "#/$defs/timestamp"},
        "end": {"$ref": "#/$defs/timestamp"}
      }
    },
    "fixture": {
      "type": "object",
      "required": ["id", "user_request", "document_common", "benign_paragraph", "attack_paragraph", "local_asset_handles", "candidate_slots", "expected_agenda", "expected_slots"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "user_request": {"type": "string", "minLength": 1},
        "document_common": {"type": "string", "minLength": 1},
        "benign_paragraph": {"type": "string", "minLength": 1},
        "attack_paragraph": {"type": "string", "minLength": 1},
        "local_asset_handles": {"$ref": "#/$defs/ids", "minItems": 1},
        "candidate_slots": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/slot"}},
        "expected_agenda": {"$ref": "#/$defs/ids", "minItems": 1},
        "expected_slots": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/slot"}}
      }
    },
    "run": {
      "type": "object",
      "required": ["attempt_id", "fixture_id", "document_variant", "repetition", "policy", "handoff", "fault", "scope"],
      "additionalProperties": false,
      "properties": {
        "attempt_id": {"$ref": "#/$defs/id"},
        "fixture_id": {"$ref": "#/$defs/id"},
        "document_variant": {"enum": ["benign", "attacked"]},
        "repetition": {"type": "integer", "minimum": 1},
        "policy": {"enum": ["S0", "S1", "S2", "S3"]},
        "handoff": {"const": "H1"},
        "fault": {"enum": ["F0", "F1"]},
        "scope": {"$ref": "#/$defs/scope"}
      }
    },
    "selection": {
      "type": "object",
      "required": ["handle", "fields", "purpose", "recipient"],
      "additionalProperties": false,
      "properties": {
        "handle": {"$ref": "#/$defs/id"},
        "fields": {"$ref": "#/$defs/fields"},
        "purpose": {"$ref": "#/$defs/id"},
        "recipient": {"$ref": "#/$defs/recipient"}
      }
    },
    "authorization": {
      "type": "object",
      "required": ["scope", "grants"],
      "additionalProperties": false,
      "properties": {
        "scope": {"$ref": "#/$defs/scope"},
        "grants": {"type": "array", "items": {"$ref": "#/$defs/selection"}}
      }
    },
    "registryObject": {
      "type": "object",
      "required": ["handle", "source", "message_role", "original_scope", "confidentiality", "integrity", "purpose", "recipients", "producer", "derivation"],
      "additionalProperties": false,
      "properties": {
        "handle": {"$ref": "#/$defs/id"},
        "source": {"$ref": "#/$defs/id"},
        "message_role": {"$ref": "#/$defs/role"},
        "original_scope": {"$ref": "#/$defs/scope"},
        "confidentiality": {"enum": ["public", "private", "derived"]},
        "integrity": {"enum": ["trusted", "untrusted"]},
        "purpose": {"$ref": "#/$defs/id"},
        "recipients": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/recipient"}},
        "producer": {"$ref": "#/$defs/id"},
        "derivation": {"$ref": "#/$defs/ids"}
      }
    },
    "handoff": {
      "type": "object",
      "required": ["artifact_id", "summary_handle", "summary_text", "summary_sha256", "parent_document_handle", "generation_send_id", "generation_mode", "loaded_message_role"],
      "additionalProperties": false,
      "properties": {
        "artifact_id": {"$ref": "#/$defs/id"},
        "summary_handle": {"$ref": "#/$defs/id"},
        "summary_text": {"type": "string", "minLength": 1},
        "summary_sha256": {"$ref": "#/$defs/sha256"},
        "parent_document_handle": {"$ref": "#/$defs/id"},
        "generation_send_id": {"$ref": "#/$defs/id"},
        "generation_mode": {"enum": ["scripted", "hosted"]},
        "loaded_message_role": {"const": "tool"}
      }
    },
    "releaseArgs": {
      "type": "object",
      "required": ["handle", "fields", "destination"],
      "additionalProperties": false,
      "properties": {
        "handle": {"$ref": "#/$defs/id"},
        "fields": {"$ref": "#/$defs/fields"},
        "destination": {"$ref": "#/$defs/recipient"}
      }
    },
    "toolProposed": {
      "type": "object",
      "required": ["event_id", "type", "tool_call_id", "name", "arguments"],
      "additionalProperties": false,
      "properties": {
        "event_id": {"$ref": "#/$defs/id"},
        "type": {"const": "tool_proposed"},
        "tool_call_id": {"$ref": "#/$defs/id"},
        "name": {"const": "release"},
        "arguments": {"$ref": "#/$defs/releaseArgs"}
      }
    },
    "policyDecision": {
      "type": "object",
      "required": ["event_id", "type", "proposal_id", "request_id", "scope", "request", "allowed", "reason"],
      "additionalProperties": false,
      "properties": {
        "event_id": {"$ref": "#/$defs/id"},
        "type": {"const": "policy_decision"},
        "proposal_id": {"type": ["string", "null"]},
        "request_id": {"$ref": "#/$defs/id"},
        "scope": {"$ref": "#/$defs/scope"},
        "request": {"$ref": "#/$defs/selection"},
        "allowed": {"type": "boolean"},
        "reason": {"$ref": "#/$defs/id"}
      }
    },
    "sendAttempt": {
      "type": "object",
      "required": ["event_id", "type", "request_id", "send_id", "channel", "recipient", "body_base64", "body_sha256", "body_bytes"],
      "additionalProperties": false,
      "properties": {
        "event_id": {"$ref": "#/$defs/id"},
        "type": {"const": "send_attempt"},
        "request_id": {"$ref": "#/$defs/id"},
        "send_id": {"$ref": "#/$defs/id"},
        "channel": {"enum": ["controller", "summary_generation", "offload"]},
        "recipient": {"$ref": "#/$defs/recipient"},
        "body_base64": {"type": "string", "minLength": 1, "contentEncoding": "base64"},
        "body_sha256": {"$ref": "#/$defs/sha256"},
        "body_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "mockReceipt": {
      "type": "object",
      "required": ["event_id", "type", "send_id", "request_sha256"],
      "additionalProperties": false,
      "properties": {
        "event_id": {"$ref": "#/$defs/id"},
        "type": {"const": "mock_receipt"},
        "send_id": {"$ref": "#/$defs/id"},
        "request_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "loadDecision": {
      "type": "object",
      "required": ["event_id", "type", "scope", "handle", "allowed", "reason"],
      "additionalProperties": false,
      "properties": {
        "event_id": {"$ref": "#/$defs/id"},
        "type": {"const": "load_decision"},
        "scope": {"$ref": "#/$defs/scope"},
        "handle": {"$ref": "#/$defs/id"},
        "allowed": {"type": "boolean"},
        "reason": {"$ref": "#/$defs/id"}
      }
    },
    "event": {
      "oneOf": [
        {"$ref": "#/$defs/loadDecision"},
        {"$ref": "#/$defs/toolProposed"},
        {"$ref": "#/$defs/policyDecision"},
        {"$ref": "#/$defs/sendAttempt"},
        {"$ref": "#/$defs/mockReceipt"}
      ]
    }
  }
}
